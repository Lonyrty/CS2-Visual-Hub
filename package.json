{
  "name": "cs2-visual-hub-stripe",
  "version": "1.0.0",
  "private": true,
  "description": "CS2 Visual Hub website and Windows companion overlay",
  "main": "desktop.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start-server": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-sqlite3": "^0.9.15",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "better-sqlite3": "^11.8.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lonyrty.cs2visualhub",
    "productName": "CS2 Visual Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop.js",
      "server.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "CS2-Visual-Hub-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
